  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "~26.3",
    "java": ">=25",
    "modmenu": ">=21.0.0-beta.1"
  },
  "suggests": {
    "jade": ">=26.3.1"
