{
  "schemaVersion": 1,
  "id": "smarttrade",
  "version": "${version}",
  "name": "CONTROL TRADE",
  "description": "A clean, vanilla-friendly foundation for configurable villager trading.",
  "authors": ["markusvdc"],
  "contact": {
    "homepage": "https://github.com/markusvdc/smarttrade",
    "sources": "https://github.com/markusvdc/smarttrade",
    "issues": "https://github.com/markusvdc/smarttrade/issues"
  },
  "custom": {
    "modmenu": {
      "links": {
        "smarttrade.link.pinterest": "https://pinterest.com/markusvdc/",
        "smarttrade.link.github": "https://github.com/markusvdc/",
        "smarttrade.link.medium": "https://markusvdc.medium.com/",
        "smarttrade.link.instagram": "https://www.instagram.com/markusvdc/"
      }
    }
  },
  "license": "MIT",
  "icon": "assets/smarttrade/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "br.com.smarttrade.SmartTrade"
    ],
